# =================================================================
# CareSetu - Environment Configuration
# =================================================================

# Google Gemini API Key (Optional: built-in deterministic coordinator acts as fallback)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Bolna AI Voice Agent Credentials (Optional: Web Speech API acts as high-fidelity demo fallback)
# Obtain from: https://console.bolna.ai/
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_API_BASE=https://api.bolna.ai

# =================================================================
# Multi-Pharmacy Provider Integrations
# Note: CareSetu gracefully falls back to simulated verified pilot responses
# when credentials are absent, ensuring offline and demo functionality.
# =================================================================

# 1. eVitalRx Network (Direct API)
# Official Docs: https://docs.evitalrx.in/
EVITALRX_API_KEY=
EVITALRX_BASE_URL=https://api.evitalrx.in/v1

# 2. MedPay Connected Care Network (Direct API - OAuth2 & API Key)
# Official Docs: https://docs.medpay.in/
MEDPAY_CLIENT_ID=
MEDPAY_CLIENT_SECRET=
MEDPAY_API_KEY=
MEDPAY_BASE_URL=https://api.medpay.in/v1

# 3. Tata 1mg Enterprise B2B Partnership (Currently Disabled Partner Placeholder)
# Requires signed Enterprise Agreement; unofficial scraping is strictly prohibited.
TATA_1MG_CLIENT_ID=
TATA_1MG_CLIENT_SECRET=
TATA_1MG_MERCHANT_ID=

# Server Port
PORT=8000
