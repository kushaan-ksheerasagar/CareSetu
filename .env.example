# =================================================================
# CareSetu - Environment Configuration
# =================================================================

# Google Gemini API Key (Optional: built-in deterministic coordinator acts as fallback)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Bolna AI Voice Agent Credentials (Optional: Web Speech API acts as high-fidelity demo fallback)
# Obtain from: https://console.bolna.ai/
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_API_BASE=https://api.bolna.ai

# Server Port
PORT=8000
